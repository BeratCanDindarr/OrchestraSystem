/* Orchestra TUI v2 Styles — Maestro Dark Theme */

$background: #1e1e1e;
$surface: #252526;
$panel-border: #3c3c3c;
$text: #cccccc;
$accent: #007acc;
$primary: #37373d;
$secondary: #6b6b6b;
$success: #4ec9b0;
$warning: #cca700;
$error: #f44747;

Screen {
    background: $background;
    color: $text;
}

#main-layout {
    layout: horizontal;
    height: 1fr;
}

.console-pane {
    height: 100%;
    border-right: tall $panel-border;
}

#left-pane {
    width: 2fr;
    background: $surface;
}

#arena-pane {
    width: 6fr;
}

#right-pane {
    width: 2fr;
    background: $surface;
    border-right: none;
}

.pane-title {
    background: $primary;
    color: white;
    text-style: bold;
    padding: 0 1;
    width: 100%;
    height: 1;
}

#command-bar {
    background: $surface;
    border-top: solid $accent;
    color: white;
    padding: 0 1;
}

#arena-streams {
    height: 1fr;
    layout: horizontal;
}

.arena-panel {
    height: 100%;
    border: solid $panel-border;
}

.arena-panel-title {
    background: #333333;
    padding: 0 1;
    text-style: italic;
    color: $secondary;
}

AgentStreamWidget {
    background: $background;
    border: none;
}

#fleet-stats {
    padding: 0 1;
    color: $secondary;
}

#total-cost {
    padding: 0 1;
    text-style: bold;
    color: $success;
    height: 1;
}

#monitor-budget {
    padding: 0 1;
    height: 1;
}

#cue-feed {
    padding: 0 1;
    color: $secondary;
}

NavigatorWidget ListItem {
    padding: 0 1;
}

NavigatorWidget ListItem:hover {
    background: $primary;
}

NavigatorWidget ListItem.--highlight {
    background: $accent;
    color: white;
}

.cue-active {
    border: solid $accent;
}

/* Modal Styling */
ModalScreen {
    align: center middle;
}

#diff-container {
    width: 92%;
    height: 88%;
    border: thick $accent;
    background: $surface;
    padding: 0 1;
}

#diff-header {
    height: 3;
    align: left middle;
}

#diff-title {
    width: 1fr;
    color: white;
    text-style: bold;
}

#diff-badge {
    width: auto;
    padding: 0 1;
    border: round $panel-border;
    background: $background;
    color: $secondary;
}

#diff-toolbar {
    height: 3;
    align: left middle;
}

.mode-button {
    min-width: 16;
    height: 3;
    margin-right: 1;
    background: $primary;
    color: $text;
    border: solid $panel-border;
}

.mode-button.-active {
    background: $accent;
    color: white;
    border: solid $accent;
    text-style: bold;
}

#diff-status-chip {
    width: auto;
    min-width: 18;
    margin-left: 1;
    padding: 0 1;
    border: round $panel-border;
    background: $background;
    color: $secondary;
}

#diff-summary {
    height: 1;
    color: $secondary;
    padding: 0 0 1 0;
}

#diff-body-shell {
    height: 1fr;
    border: tall $panel-border;
    background: $background;
}

#diff-unified-view {
    height: 1fr;
    padding: 0 1;
}

#diff-side-by-side {
    height: 1fr;
}

.diff-pane {
    width: 1fr;
    height: 1fr;
}

.diff-pane:first-child {
    border-right: tall $panel-border;
}

.diff-pane-title {
    height: 1;
    background: $primary;
    color: white;
    text-style: bold;
    padding: 0 1;
}

.diff-scroll {
    height: 1fr;
    padding: 0 1;
}

.diff-body {
    width: auto;
    min-width: 100%;
    color: $text;
}

#diff-footer {
    height: 1;
    padding: 1 0 0 0;
    color: $secondary;
}

/* Collapsible Tool Blocks */
Collapsible {
    border: none;
    margin: 0;
    padding: 0;
}

CollapsibleTitle {
    background: $primary;
    color: $secondary;
    padding: 0 1;
}

CollapsibleTitle:hover {
    background: $accent;
    color: white;
}

/* UX Polish: Focus & Feedback */

Screen:focus-within {
    /* Ensure child focus is visible */
}

#left-pane:focus-within, #arena-pane:focus-within, #right-pane:focus-within {
    border: solid $accent;
    border-subtitle-align: center;
    border-subtitle-color: $accent;
}

#left-pane:focus-within { border-subtitle: "NAVIGATOR"; }
#arena-pane:focus-within { border-subtitle: "ARENA"; }
#right-pane:focus-within { border-subtitle: "MONITOR"; }

.arena-panel.-active {
    border: double $success;
    border-subtitle: "STREAMING";
    border-subtitle-color: $success;
}

/* Scrollbar Polish */
RichLog, ListView, Markdown {
    scrollbar-size: 1 1;
    scrollbar-color: $secondary;
    scrollbar-color-hover: $accent;
    scrollbar-background: transparent;
}

/* Animations for background tasks */
@keyframes pulse_border {
    from { border: solid #3c3c3c; }
    to { border: solid #4ec9b0; }
}

.cue-active {
    animation: pulse_border 1s infinite alternate;
}


/* Information Density Polish */
NavigatorWidget ListItem Static {
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
}

