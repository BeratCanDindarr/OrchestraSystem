# Orchestra Policy Engine — Example Configuration
# Copy this file to .orchestra/policy.yaml to enable declarative governance.
# When policy.yaml exists, legacy TOML approval_policies are ignored.

version: "1.0"

approval:
  # Provider trust levels: auto | gated | sandbox_only | deny
  providers:
    claude: auto
    codex: auto
    gemini: gated
    ollama: sandbox_only
    deepseek: deny

  # Modes that always require human approval (OR logic with provider rules)
  mode_gates:
    - critical
    - planned

  # Keywords in the task prompt that trigger approval
  privileged_actions:
    - git push
    - deploy
    - migration
    - delete
    - rm -rf
    - production
    - financial
    - payment
    - user data

tools:
  # Tool permission levels: auto | gated | deny
  file_read: auto
  web_search: auto
  git_push: gated
  shell_exec: deny

budget:
  # 0 = unlimited
  max_usd_per_run: 2.0
  max_usd_per_day: 10.0
